APP_NAME="mypage.ng"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@mypage.ng"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Payments. PAYMENT_GATEWAY picks the implementation; paystack and flutterwave
# both exist. Keys come from the provider's dashboard — test keys from the test
# toggle, and never the live pair on a machine that pushes.
PAYMENT_GATEWAY=paystack
PAYSTACK_SECRET=
PAYSTACK_PUBLIC=
FLUTTERWAVE_SECRET=
FLUTTERWAVE_SECRET_HASH=

# Recurring billing. A plan without a code here is charged one period at a time
# by hand and nothing renews on its own — so a missing code is safe, but a
# wrong one is not: Paystack charges the plan's amount in place of the amount
# this application sends. Copy the PLN_... code from the plan's page, and create
# the plan with the same interval and price as config/billing.php.
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_PRO=

# Google sign-in for sellers. Leave empty to hide the Google button.
# Authorised redirect URI must be exactly <app_url>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# Escrow ships dark. Turn this on to route new sales into escrow; a seller can
# still be opted out per-account by a row in feature_flags.
FEATURE_ESCROW=true
FEATURE_DIRECTORY=true
FEATURE_CUSTOM_DOMAINS=true
ESCROW_AUTO_RELEASE_DAYS=7

