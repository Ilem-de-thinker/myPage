APP_NAME="mypage.ng"
APP_ENV=local
APP_KEY=
# Comma-separated old keys, only while rotating. Seller gateway secrets are
# encrypted with APP_KEY; without the old key here a rotation makes every saved
# secret unreadable, and every seller has to paste their key again.
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Optional wildcard host for tenant subdomains. If omitted, the host is read
# from APP_URL (for example, APP_URL=http://192.168.1.20:8000).
# APP_DOMAIN=
# subdomain (default) serves {store}.{domain}; path serves /store/{slug} on the
# apex and needs no wildcard DNS or TLS. Use path only when the host cannot
# provide wildcard subdomains.
STOREFRONT_MODE=subdomain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90

# Provider-agnostic AI. Change a task's provider/model here and clear config;
# feature code does not change. Prism supports the configured provider keys.
# Admin AI settings take precedence over these values; blank keeps the fallback.
AI_ENABLED=true
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=
AI_RETRIES=
AI_DEFAULT_TIMEOUT=30
AI_DEFAULT_RETRIES=1
AI_STRUCTURED_MODE=auto
AI_FREE_MONTHLY_CREDITS=25
AI_PAID_MONTHLY_CREDITS=500
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1
AI_EMBEDDINGS_ENABLED=false
AI_EMBEDDINGS_PROVIDER=openai
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
AI_EMBEDDINGS_TIMEOUT=20
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_SITE_BUILDER_PROVIDER=groq
AI_SITE_BUILDER_MODEL=openai/gpt-oss-120b
AI_THEME_PROVIDER=groq
AI_THEME_MODEL=openai/gpt-oss-120b
AI_LISTING_PHOTO_PROVIDER=groq
AI_LISTING_PHOTO_MODEL=qwen/qwen3.8-27b
AI_STORE_ASSISTANT_PROVIDER=groq
AI_STORE_ASSISTANT_MODEL=openai/gpt-oss-120b
AI_BOOKING_ASSISTANT_PROVIDER=groq
AI_BOOKING_ASSISTANT_MODEL=openai/gpt-oss-120b
AI_ORDER_CHAT_PROVIDER=groq
AI_ORDER_CHAT_MODEL=openai/gpt-oss-120b
AI_INSIGHTS_PROVIDER=groq
AI_INSIGHTS_MODEL=openai/gpt-oss-120b
AI_DATA_PROVIDER=groq
AI_DATA_MODEL=openai/gpt-oss-120b
AI_SEARCH_PROVIDER=groq
AI_SEARCH_MODEL=openai/gpt-oss-120b
AI_TRANSLATE_PROVIDER=groq
AI_TRANSLATE_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=

CACHE_STORE=database
# Database cache is intentional for deployments without Redis.
DB_CACHE_TABLE=cache
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@mypage.ng"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Payments. PAYMENT_GATEWAY picks the implementation; paystack and flutterwave
# both exist. Keys come from the provider's dashboard — test keys from the test
# toggle, and never the live pair on a machine that pushes.
PAYMENT_GATEWAY=paystack
PAYSTACK_SECRET=
PAYSTACK_PUBLIC=
FLUTTERWAVE_SECRET=
FLUTTERWAVE_SECRET_HASH=

# Recurring billing. A plan without a code here is charged one period at a time
# by hand and nothing renews on its own — so a missing code is safe, but a
# wrong one is not: Paystack charges the plan's amount in place of the amount
# this application sends. Copy the PLN_... code from the plan's page, and create
# the plan with the same interval and price as config/billing.php.
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_PRO=

# Google sign-in for sellers. Leave empty to hide the Google button.
# Authorised redirect URI must be exactly <app_url>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
# Browser key restricted by HTTP referrer for the Maps JavaScript API and Places API.
GOOGLE_MAPS_BROWSER_KEY=

# Escrow ships dark. Turn this on to route new sales into escrow; a seller can
# still be opted out per-account by a row in feature_flags.
FEATURE_ESCROW=true
FEATURE_DIRECTORY=true
FEATURE_CUSTOM_DOMAINS=true
ESCROW_AUTO_RELEASE_DAYS=7

