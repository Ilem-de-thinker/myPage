<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^\.well-known/ - [L]

    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|tests|vendor|node_modules)(?:/|$) - [F,L,NC]

    RewriteRule (^\.|/\.) - [F,L]

    # Already mapped to public/ - stop applying THIS ruleset, but let Apache
    # continue into public/.htaccess so non-file URLs reach Laravel's front
    # controller. [L], never [END]: END would block public/.htaccess too and
    # every Laravel route would 404.
    RewriteRule ^public/ - [L]

    RewriteRule ^$ public/index.php [L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
