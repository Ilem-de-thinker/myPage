<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^\.well-known/ - [L]

    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|tests|vendor|node_modules)(?:/|$) - [F,L,NC]

    RewriteRule (^\.|/\.) - [F,L]

    # Already mapped to public/ - never rewrite again, no matter what pass this is.
    # [END] also stops any re-processing in per-directory context.
    RewriteRule ^public/ - [END]

    RewriteRule ^$ public/index.php [L,END]

    RewriteRule ^(.*)$ public/$1 [L,END]
</IfModule>
